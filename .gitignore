# Build output
debug
target/
**/*.rs.bk
*.pdb
**/mutants.out*/

.claude/
.env

# Model weights and training corpora. The leading slash matters: an unanchored
# pattern matches at every depth, which once untracked all of src/models/ and
# the tests/data/ golden fixture.
/models/
/checkpoints/
/data/

# assets/ is deliberately not ignored. assets/shakespeare_char/ is the 43 MB
# demo checkpoint two pages load, so it must be in the repo — and not in Git
# LFS, because Pages serves LFS pointer files as text.

# Built pages and the downloaded Tailwind CLI.
/docs/dist/
/tools/*/dist/
/.cache/

# Local notes, not for the public repo.
/plan/
/references/
/logs/
/roadmap/
