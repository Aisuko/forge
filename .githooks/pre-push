#!/usr/bin/env bash
# Full local CI gate: everything pre-commit checks, plus the release test
# suite — gpt2_e2e and kv_cache against real GPU hardware and the HF goldens,
# which a GPU-less hosted runner cannot do.
#
# It re-runs the pre-commit checks on purpose: a push can carry commits made
# with --no-verify, or fetched from another machine.
#
# Installed by scripts/common/install_hooks.sh. Bypass with `git push --no-verify`.
set -euo pipefail

# git feeds one "<local ref> <local sha> <remote ref> <remote sha>" line per
# pushed ref on stdin, with an all-zero local sha for a deletion. A
# deletion-only push (`git push origin :branch`) changes no code, so there is
# nothing to verify. An empty stdin means the hook was invoked by hand — run.
refs=0
updates=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  refs=$((refs + 1))
  [[ "$local_sha" =~ ^0+$ ]] || updates=$((updates + 1))
done
if [[ "$refs" -gt 0 && "$updates" -eq 0 ]]; then
  echo "pre-push: deletions only, nothing to verify"
  exit 0
fi

# Bounded, because the failure mode this is protecting against is not a red
# test: a GPU driver can wedge a test binary, and an unbounded hook turns that
# into a `git push` that hangs for hours with nothing printed. `full` is ~1m10s
# warm, so 15 minutes is a wedge, not a slow machine. `--foreground` keeps the
# script attached to the terminal so its output still streams.
#
# `timeout` signals the script, not its grandchildren, so a wedged test binary
# can outlive this — the push fails loudly either way, which is the point.
timeout --foreground --kill-after=30s 15m ./scripts/local/ci_local.sh full
status=$?
if [[ "$status" -eq 124 || "$status" -eq 137 ]]; then
  echo "pre-push: ci_local.sh full ran past 15m and was killed — something is" >&2
  echo "          wedged, not slow. Check for a leftover test binary holding a" >&2
  echo "          GPU device (ps -ef | grep target/release/deps)." >&2
fi
exit "$status"
