#!/usr/bin/env bash
# Fast local CI gate: fmt, clippy, the builds, the dep-leak assert, the site.
# About 7s with a warm target/. The release suite runs on pre-push instead — a
# minute is too slow to pay on every WIP commit.
#
# Installed by scripts/common/install_hooks.sh. Bypass with `git commit --no-verify`.
set -euo pipefail

# This gate checks the working tree, not the staged snapshot, so a partially
# staged change can commit a state that was never checked on its own.
if ! git diff --quiet; then
  printf '\033[33mnote:\033[0m unstaged changes present — this gate checks the working tree, not the index\n' >&2
fi

exec ./scripts/local/ci_local.sh fast
